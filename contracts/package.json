    "undici": "^7.29.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
