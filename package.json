{
  "name": "vantage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:contracts": "npm --prefix contracts run compact:compile",
    "deploy:contracts": "npm --prefix contracts run deploy",
    "test": "npm run test:contracts",
    "test:contracts": "npm --prefix contracts test",
    "test:e2e": "npm --prefix contracts test -- tests/e2e-scenario.test.ts",
    "test:watch": "npm --prefix contracts run test:watch"
  }
}
